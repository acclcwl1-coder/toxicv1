-- ── PREMIUM ICON SYSTEM ─────────────────────────────────────────────────────
-- Each icon: 24x24 canvas, pixel-precise frame shapes, animated glow chip,
-- gradient stroke on active, UIScale for hover bounce.
local function makeSideIcon(parent, kind)
    -- outer holder (24x24, vertically centered)
    local holder=Instance.new("Frame",parent)
    holder.Name="Icon"
    holder.Size=UDim2.new(0,24,0,24)
    holder.Position=UDim2.new(0,10,0.5,-12)
    holder.BackgroundTransparency=1
    holder.BorderSizePixel=0
    holder.ZIndex=7
    local usc=Instance.new("UIScale",holder); usc.Scale=1

    -- animated glow chip (shown when active)
    local chip=Instance.new("Frame",holder)
    chip.Name="Chip"
    chip.AnchorPoint=Vector2.new(0.5,0.5)
    chip.Position=UDim2.new(0.5,0,0.5,0)
    chip.Size=UDim2.new(0,34,0,34)
    chip.BackgroundColor3=C.accent
    chip.BackgroundTransparency=1
    chip.BorderSizePixel=0
    chip.ZIndex=5
    Instance.new("UICorner",chip).CornerRadius=UDim.new(0,10)
    -- subtle inner glow gradient on chip
    local cg=Instance.new("UIGradient",chip)
    cg.Color=ColorSequence.new({
        ColorSequenceKeypoint.new(0,Color3.fromRGB(160,80,255)),
        ColorSequenceKeypoint.new(1,Color3.fromRGB(90,30,180)),
    })
    cg.Rotation=135

    -- helper: solid rect piece
    local function px(nm,sz,pos,rad,alpha)
        local f=Instance.new("Frame",holder)
        f.Name=nm; f.Size=sz; f.Position=pos
        f.BackgroundColor3=C.tabIdleTx
        f.BackgroundTransparency=alpha or 0
        f.BorderSizePixel=0; f.ZIndex=8
        Instance.new("UICorner",f).CornerRadius=UDim.new(0,rad or 0)
        return f
    end

    -- helper: outlined ring (hollow circle)
    local function ring(nm,sz,pos,rad,thick)
        local f=Instance.new("Frame",holder)
        f.Name=nm; f.Size=sz; f.Position=pos
        f.BackgroundTransparency=1; f.BorderSizePixel=0; f.ZIndex=8
        Instance.new("UICorner",f).CornerRadius=UDim.new(0,rad)
        local st=Instance.new("UIStroke",f)
        st.Thickness=thick or 1.5; st.Color=C.tabIdleTx; st.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
        return f,st
    end

    if kind=="aim" then
        -- Precision crosshair: outer ring + 4 gap ticks + center diamond
        local r,rst=ring("Ring",UDim2.new(0,20,0,20),UDim2.new(0,2,0,2),10,1.6)
        -- outer corner notches (top/bottom/left/right gaps)
        px("GapT",UDim2.new(0,4,0,5),UDim2.new(0,10,0,-1),0,0)   -- mask top gap
        px("GapB",UDim2.new(0,4,0,5),UDim2.new(0,10,0,20),0,0)   -- mask bot gap
        px("GapL",UDim2.new(0,5,0,4),UDim2.new(0,-1,0,10),0,0)
        px("GapR",UDim2.new(0,5,0,4),UDim2.new(0,20,0,10),0,0)
        -- center diamond dot
        local dot=px("Dot",UDim2.new(0,5,0,5),UDim2.new(0,9.5,0,9.5),1)
        dot.Rotation=45
        -- four tick lines
        px("TL",UDim2.new(0,1.5,0,4),UDim2.new(0,11.25,0,2),1)
        px("TB",UDim2.new(0,1.5,0,4),UDim2.new(0,11.25,0,18),1)
        px("TLL",UDim2.new(0,4,0,1.5),UDim2.new(0,2,0,11.25),1)
        px("TRR",UDim2.new(0,4,0,1.5),UDim2.new(0,18,0,11.25),1)

    elseif kind=="visuals" then
        -- Premium eye: outer lens shape + inner iris ring + pupil + glint
        local lens=px("Lens",UDim2.new(0,22,0,14),UDim2.new(0,1,0,5),7,1)
        local lst=Instance.new("UIStroke",lens); lst.Thickness=1.6; lst.Color=C.tabIdleTx
        lens.BackgroundTransparency=1
        -- iris ring
        local iris,_=ring("Iris",UDim2.new(0,10,0,10),UDim2.new(0,7,0,7),5,1.4)
        -- filled pupil
        px("Pupil",UDim2.new(0,5,0,5),UDim2.new(0,9.5,0,9.5),3)
        -- glint top-right
        px("Glint",UDim2.new(0,2.5,0,2.5),UDim2.new(0,14,0,7),2,0.3)
        -- eyelash curves (top arc line segments)
        px("LashL",UDim2.new(0,5,0,1.5),UDim2.new(0,1,0,4),1,0.5)
        px("LashR",UDim2.new(0,5,0,1.5),UDim2.new(0,18,0,4),1,0.5)

    elseif kind=="movement" then
        -- Lightning bolt / speed chevrons: bold double arrow pointing right
        -- Arrow 1 (front, full opacity)
        local a1t=px("A1T",UDim2.new(0,2,0,9),UDim2.new(0,5,0,3),1)
        a1t.AnchorPoint=Vector2.new(0.5,1); a1t.Rotation=35
        local a1b=px("A1B",UDim2.new(0,2,0,9),UDim2.new(0,5,0,12),1)
        a1b.AnchorPoint=Vector2.new(0.5,0); a1b.Rotation=-35
        -- Arrow 2 (back, dimmed)
        local a2t=px("A2T",UDim2.new(0,2,0,9),UDim2.new(0,12,0,3),1,0.45)
